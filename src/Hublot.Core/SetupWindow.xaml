<Window x:Class="HublotCore.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HublotCore"
        Title="{local:Tr InstallationDeHublot}" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32,28,32,24">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource HublotLogo}" Width="56" Height="56" />
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Hublot" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="0,20,0,0"
                   Text="{local:Tr DesModulesVisuelsPourWindows}" />

        <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0">
            <DockPanel>
                <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr LancerAuDemarrageDeWindows}" FontSize="14" />
                    <TextBlock Text="{local:Tr ModifiableEnsuiteDansLesParametres}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" FontSize="13" Margin="2,16,0,0" MinHeight="18" />
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="Hidden" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CloseButton" Content="{local:Tr Annuler}" Padding="18,6" Margin="0,0,8,0" Click="OnClose" />
            <Button x:Name="InstallButton" Content="{local:Tr Installer}" Padding="22,6" Click="OnInstall" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
