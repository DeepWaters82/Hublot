<Window x:Class="HublotCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HublotCore"
        Title="Hublot" Icon="{StaticResource HublotLogo}"
        Width="1000" Height="740" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="DeviceRow">
            <Border Style="{StaticResource RowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="2,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Notify}"
                              ToolTip="{local:Tr PopupsPourCetAppareil}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Volet de navigation (réduit aux icônes dans une fenêtre étroite) -->
        <DockPanel Margin="10,6,6,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,18">
                <Image Source="{StaticResource HublotLogo}" Width="28" Height="28" />
                <TextBlock x:Name="NavTitle" Text="Hublot" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <Grid>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" SelectionChanged="OnNavigate"
                     ItemContainerStyle="{StaticResource NavItem}">
                <ListBoxItem Tag="Home" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr Accueil}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr General}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr Apparence}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem IsEnabled="False" Focusable="False">
                    <TextBlock Text="{local:Tr Modules}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-4,10,0,0" />
                </ListBoxItem>
                <ListBoxItem Tag="Devices">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr AppareilsSansFil}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Notifications">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr NotificationsDAppareils}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="NowPlaying">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr LectureEnCours}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Usb">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr PeripheriquesUsb}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Displays">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr Ecrans}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Audio" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr PriseAudio}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Power">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA93;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr Alimentation}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem IsEnabled="False" Focusable="False" Height="8" />
                <ListBoxItem Tag="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{local:Tr APropos}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <!-- Barre de sélection : glisse d'un élément à l'autre (MainWindow.MovePill) -->
            <Canvas x:Name="NavOverlay" IsHitTestVisible="False">
                <Border x:Name="NavPill" Width="3" Height="16" CornerRadius="1.5" Visibility="Hidden"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
            </Canvas>
            </Grid>
        </DockPanel>

        <!-- Zone de contenu -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PageContent" Margin="40,28,40,40" MaxWidth="1000">

                    <!-- ═══ Accueil ═══ -->
                    <StackPanel x:Name="HomePage">
                        <TextBlock Text="{local:Tr Accueil}" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="6,0,18,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" FontSize="14" />
                                    <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" />
                                </StackPanel>
                                <Button x:Name="StartButton" Grid.Column="2" Content="{local:Tr Demarrer}" Padding="16,6" Click="OnStartService"
                                        Style="{DynamicResource AccentButtonStyle}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{local:Tr Modules}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleBluetooth}"><TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,16,0" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleBluetooth}">
                                    <TextBlock Text="{local:Tr AppareilsSansFil}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Tr BatterieEtConnexionDesAppareils}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <Button Content="{local:Tr Configurer}" Tag="Devices" Click="OnConfigure" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ModuleBluetooth}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleNowPlaying}"><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,16,0" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleNowPlaying}">
                                    <TextBlock Text="{local:Tr LectureEnCours}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Tr AfficheLeTitreEtL}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <Button Content="{local:Tr Configurer}" Tag="NowPlaying" Click="OnConfigure" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ModuleNowPlaying}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleUsb}"><TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,16,0" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleUsb}">
                                    <TextBlock Text="{local:Tr PeripheriquesUsb}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Tr NomEtEtatDesPeripheriques}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <Button Content="{local:Tr Configurer}" Tag="Usb" Click="OnConfigure" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ModuleUsb}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleDisplays}"><TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,16,0" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleDisplays}">
                                    <TextBlock Text="{local:Tr Ecrans}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Tr NomConnectiqueEtResolutionD}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <Button Content="{local:Tr Configurer}" Tag="Displays" Click="OnConfigure" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ModuleDisplays}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <!-- Module « Prise audio » mis de côté (3.7.2) : tuile, entrée de navigation et page masquées. -->
                        <Border Style="{StaticResource CardBorder}" Padding="20,18" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleAudio}"><TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,16,0" Style="{StaticResource ModuleDim}" Tag="{Binding ModuleAudio}">
                                    <TextBlock Text="{local:Tr PriseAudio}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Tr CasqueOuMicroSurLaPrise}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <Button Content="{local:Tr Configurer}" Tag="Audio" Click="OnConfigure" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ModuleAudio}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Style="{StaticResource ModuleDim}" Tag="{Binding ModulePower}"><TextBlock Text="&#xEA93;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,16,0" Style="{StaticResource ModuleDim}" Tag="{Binding ModulePower}">
                                    <TextBlock Text="{local:Tr Alimentation}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{local:Tr NomDuPcEtCharge}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <Button Content="{local:Tr Configurer}" Tag="Power" Click="OnConfigure" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ModulePower}" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="2,12,0,0" />
                    </StackPanel>

                    <!-- ═══ Général ═══ -->
                    <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                        <TextBlock Text="{local:Tr General}" Style="{StaticResource PageTitle}" />


                        <local:SettingsCard Icon="&#xE774;" Header="{local:Tr Language}" Description="{local:Tr LanguageDescription}">
                            <ComboBox SelectedIndex="{Binding LanguageIndex}" Width="260">
                                <ComboBoxItem Content="{local:Tr LanguageAuto}" />
                                <ComboBoxItem Content="{local:Tr LanguageFrench}" />
                                <ComboBoxItem Content="{local:Tr LanguageEnglish}" />
                            </ComboBox>
                        </local:SettingsCard>

                        <TextBlock Text="{local:Tr Demarrage}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE7E8;" Header="{local:Tr LancerAuDemarrageDeWindows}"
                                            Description="{local:Tr DemarreHublotALOuverture}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                        </local:SettingsCard>

                        <TextBlock Text="{local:Tr Popup}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE916;" Header="{local:Tr DureeDAffichage}"
                                            Description="{local:Tr LePopupResteAussiAffiche}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding DurationSeconds}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0} s}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE7C9;" Header="{local:Tr ClicSurLePopup}"
                                            Description="{local:Tr FermerLePopupOuOuvrir}">
                            <ComboBox SelectedIndex="{Binding ClickActionIndex}" Width="260">
                                <ComboBoxItem Content="{local:Tr FermerLePopup}" />
                                <ComboBoxItem Content="{local:Tr OuvrirLesParametresBluetooth}" />
                            </ComboBox>
                        </local:SettingsCard>

                        <TextBlock Text="{local:Tr AppareilsConnectes}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE765;" Header="{local:Tr RaccourciClavier}"
                                            Description="{local:Tr AfficheTousLesAppareilsConnectes}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="170" IsReadOnly="True" Text="{Binding HotkeyText, Mode=OneWay}"
                                         TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"
                                         PreviewKeyDown="OnHotkeyKeyDown" IsEnabled="{Binding HotkeyEnabled}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HotkeyEnabled}" />
                            </StackPanel>
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE7EF;" Header="{local:Tr SurvolDeLIconeDe}"
                                            Description="{local:Tr LesAppareilsConnectesEtLeur}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HoverList}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE703;" Header="{local:Tr AfficherAussiLesAppareilsDeconnectes}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HoverShowDisconnected}" IsEnabled="{Binding HoverList}" />
                        </local:SettingsCard>

                        <TextBlock Text="{local:Tr NePasDeranger}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE740;" Header="{local:Tr NePasAfficherPendantUne}"
                                            Description="{local:Tr JeuxVideosPresentationsLesModules}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}" />
                        </local:SettingsCard>
                    </StackPanel>

                    <!-- ═══ Notifications ═══ -->
                    <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                        <TextBlock Text="{local:Tr Notifications}" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource ModuleOffNotice}" Tag="{Binding ModuleBluetooth}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{local:Tr ModuleDesactive}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Style="{StaticResource ModuleOptions}" IsEnabled="{Binding ModuleBluetooth}">

                        <TextBlock Text="{local:Tr Connexion}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
                        <local:SettingsCard Icon="&#xE8FB;" Header="{local:Tr ConnexionDUnAppareil}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyConnect}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE8D8;" Header="{local:Tr DeconnexionDUnAppareil}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDisconnections}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE710;" Header="{local:Tr NouveauPeripheriqueDetecte}"
                                            Description="{local:Tr PremiereConnexionDUnAppareil}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyNewDevice}" />
                        </local:SettingsCard>

                        <TextBlock Text="{local:Tr Batterie}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE850;" Header="{local:Tr BatterieFaible}"
                                            Description="{local:Tr UneAlerteParDecharge}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="150" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding LowBatteryThreshold}" VerticalAlignment="Center" IsEnabled="{Binding NotifyLowBattery}" />
                                <TextBlock Text="{Binding LowBatteryThreshold, StringFormat={}{0} %}" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyLowBattery}" />
                            </StackPanel>
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE945;" Header="{local:Tr MiseEnCharge}"
                                            Description="{local:Tr QuandUnAppareilCommenceA}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyCharging}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE83F;" Header="{local:Tr NiveauDeChargeAtteint}"
                                            Description="{local:Tr QuandLaBatterieAtteintCe}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="150" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding ChargeTarget}" VerticalAlignment="Center" IsEnabled="{Binding NotifyChargeTarget}" />
                                <TextBlock Text="{Binding ChargeTarget, StringFormat={}{0} %}" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyChargeTarget}" />
                            </StackPanel>
                        </local:SettingsCard>

                        <TextBlock Text="{local:Tr NePasDeranger}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE7E8;" Header="{local:Tr IgnorerLesAppareilsConnectesAu}"
                                            Description="{local:Tr PasDePopupPourLes}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IgnoreStartupConnections}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE708;" Header="{local:Tr IgnorerLesReconnexionsApresLa}"
                                            Description="{local:Tr PasDePopupALa}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IgnoreResumeConnections}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE765;" Header="{local:Tr IgnorerLaVeilleDesClaviers}"
                                            Description="{local:Tr PasDePopupQuandIls}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QuietInputSleep}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE962;" Header="{local:Tr IgnorerLaVeilleDesSouris}"
                                            Description="{local:Tr PasDePopupQuandEllesSeReveillent}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QuietMouseSleep}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE74F;" Header="{local:Tr AppareilsEnSourdine}"
                                            Description="{local:Tr ChoisissezLesAppareilsAutorisesA}">
                            <Button Content="{local:Tr OuvrirLaPageAppareils}" Padding="14,6" Click="OnOpenDevices" />
                        </local:SettingsCard>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ Apparence ═══ -->
                    <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel x:Name="AppearanceActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Padding="14,6" Click="OnPreview" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{local:Tr Apercu}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="14,6" Click="OnPreviewMedia" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{local:Tr LectureEnCours}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="14,6" Click="OnPreviewList">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{local:Tr ApercuDeLaListe}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{local:Tr Apparence}" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <TextBlock Text="{local:Tr Emplacement}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <!-- Côte à côte, ou l'un sous l'autre dans une fenêtre étroite. -->
                            <WrapPanel>
                                <StackPanel Margin="0,0,28,8">
                                    <Border Width="300" Height="172" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Grid x:Name="Spots">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="14" />
