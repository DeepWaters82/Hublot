                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{local:Tr ModuleDesactive}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Style="{StaticResource ModuleOptions}" IsEnabled="{Binding ModuleDisplays}">
                        <TextBlock Text="{local:Tr Popup}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xE8FB;" Header="{local:Tr BranchementDUnEcran}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisplayNotifyConnect}" />
                        </local:SettingsCard>
                        <local:SettingsCard Icon="&#xE8D8;" Header="{local:Tr DebranchementDUnEcran}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisplayNotifyDisconnect}" />
                        </local:SettingsCard>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ À propos ═══ -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <TextBlock Text="{local:Tr APropos}" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource HublotLogo}" Width="48" Height="48" />
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Hublot" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="13" Margin="0,16,0,0"
                                           Text="{local:Tr UneSerieDePopupsFluent}" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="{local:Tr OuvrirLeDossierDesParametres}" Padding="14,6" Click="OnOpenFolder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Version classique seulement (la version Store est mise à jour par le Store) -->
                        <StackPanel x:Name="UpdatesSection">
                            <TextBlock Text="{local:Tr Update.Section}" Style="{StaticResource SectionHeader}" />
                            <local:SettingsCard Icon="&#xE896;" Header="{local:Tr Update.Auto}" Description="{local:Tr Update.AutoDescription}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckUpdates}" />
                            </local:SettingsCard>
                            <Border Style="{StaticResource CardBorder}" Padding="20,14">
                                <DockPanel>
                                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="{local:Tr Update.Check}" Padding="14,6" Click="OnCheckUpdate" />
                                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{local:Tr Diag.Section}" Style="{StaticResource SectionHeader}" />
                        <local:SettingsCard Icon="&#xEBE8;" Header="{local:Tr Diag.Log}" Description="{local:Tr Diag.LogDescription}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DiagnosticLog}" />
                        </local:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
