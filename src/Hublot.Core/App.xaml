<Application x:Class="HublotCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HublotCore"
             ThemeMode="System">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Carte de réglage (équivalent du SettingsCard de PowerToys / Windows Community Toolkit) -->
        <Style TargetType="local:SettingsCard">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingsCard">
                        <Border Style="{StaticResource CardBorder}" MinHeight="68">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           VerticalAlignment="Center" Margin="2,0,18,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interrupteur Fluent (ToggleSwitch) à partir d'une CheckBox -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{local:Tr Desactive}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="54" TextAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Grid Width="40" Height="20">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                        Background="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="Shift" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Label" Property="Text" Value="{local:Tr Active}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.167">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.167">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Options d'un module (IsEnabled lié au module) : grisées et inactives quand il est désactivé -->
        <Style x:Key="ModuleOptions" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Élément estompé quand le module (Tag) est désactivé, sans être inactif (bouton « Configurer ») -->
        <Style x:Key="ModuleDim" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bandeau « module désactivé » (Tag = état du module), visible seulement quand il est désactivé -->
        <Style x:Key="ModuleOffNotice" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Emplacement du popup sur l'écran miniature -->
        <Style x:Key="SpotButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="GroupName" Value="Position" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Spot" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Spot" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Spot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Spot" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Spot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Élément du volet de navigation (indicateur d'accent à gauche, comme NavigationView) -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="4" Margin="0,2" Padding="12,9" Background="Transparent">
                            <!-- Indicateur de sélection : une seule barre animée, superposée à la liste (MainWindow.NavPill). -->
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Choix de l'icône de notification : carte sélectionnable -->
        <Style x:Key="IconChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="TrayIcon" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Width="118" Padding="10" CornerRadius="6" BorderThickness="2"
                                BorderBrush="Transparent" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="WindowsBlue" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A8CE6" Offset="0" />
            <GradientStop Color="#0067C0" Offset="1" />
        </LinearGradientBrush>

        <!-- Logo de Hublot : un hublot et sa croisée (même dessin que l'icône du service), aux couleurs
             d'accentuation du thème : accentuation claire et traits sombres en mode sombre, l'inverse en mode clair. -->
        <DrawingImage x:Key="HublotLogo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource AccentFillColorDefaultBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="11.6" RadiusY="11.6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Croisée puis cerclage (même dessin que TrayIconRenderer) -->
                    <GeometryDrawing Brush="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Geometry="M11.27,3.5 h1.46 v17 h-1.46 Z M3.5,11.27 h17 v1.46 h-17 Z" />
                    <DrawingGroup Opacity="0.9">
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Thickness="1.55" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                    <DrawingGroup Opacity="0.55">
                        <GeometryDrawing Geometry="M6.89,10.73 A5.27,5.27 0 0 1 10.02,7.11">
                            <GeometryDrawing.Pen>
                                <Pen Brush="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Thickness="1.06" StartLineCap="Round" EndLineCap="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Ligne compacte (listes d'appareils, d'applications) -->
        <Style x:Key="RowBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Application.Resources>
</Application>
